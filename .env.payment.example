# Payment microservice (./payment). See payment/README.MD for every variable.

# gorm/pgx DSN. Inside Docker the host is the Postgres service name.
DATABASE_URL=host=postgres user=postgres password=change-me dbname=payment port=5432 sslmode=disable

# The image defaults to :8080; the backend reaches it at PAYMENT_SERVICE_URL=http://payment:8080.
LISTEN_ADDRESS=:8080

# Zibal is the active gateway (cmd/payment/main.go). "zibal" is Zibal's sandbox merchant.
ZIBAL_MERCHANT=change-me

GIN_MODE=release
LOG_LEVEL=info
