    {
      "id": 14,
      "type": "table",
      "title": "Plans: price, capacity and fill",
      "description": "",
      "gridPos": {
        "x": 0,
        "y": 23,
        "w": 24,
        "h": 9
      },
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "wss-backend-db"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "wss-backend-db"
          },
          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT pl.id, pl.kind,\n  coalesce(w.name, sc.course_name, '') AS workshop_or_course,\n  m.name AS attendance,\n  pl.price / 10 AS price_toman,\n  pl.capacity,\n  count(pp.id) AS registered,\n  CASE WHEN pl.capacity > 0 THEN count(pp.id)::float / pl.capacity END AS fill,\n  pl.is_open\nFROM participant_participationplan pl\nLEFT JOIN core_workshop w ON w.id = pl.workshop_id\nLEFT JOIN spotplayer_spotplayercourse sc ON sc.id = pl.spotplayer_course_id\nLEFT JOIN participant_modeofattendance m ON m.id = pl.mode_of_attendance_id\nLEFT JOIN participant_participation pp ON pp.plan_id = pl.id\nWHERE pl.event_id = ${event}\nGROUP BY pl.id, w.name, sc.course_name, m.name\nORDER BY registered DESC"
        }
      ],
      "fieldConfig": {
        "defaults": {},
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "fill"
            },
            "properties": [
              {
                "id": "unit",
                "value": "percentunit"
              },
              {
                "id": "max",
                "value": 1
              },
              {
                "id": "custom.cellOptions",
                "value": {
                  "type": "gauge",
                  "mode": "basic"
                }
              },
              {
                "id": "thresholds",
                "value": {
                  "mode": "absolute",
                  "steps": [
                    {
                      "color": "green",
                      "value": null
                    },
                    {
                      "color": "orange",
                      "value": 0.8
                    },
                    {
                      "color": "red",
                      "value": 0.95
                    }
                  ]
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "price_toman"
            },
            "properties": [
              {
                "id": "unit",
                "value": "locale"
              }
            ]
          }
        ]
      },
      "options": {
        "showHeader": true,
        "sortBy": [
          {
            "displayName": "registered",
            "desc": true
          }
        ]
      }
    },
