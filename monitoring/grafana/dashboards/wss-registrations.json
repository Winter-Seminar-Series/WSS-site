          "rawQuery": true,
          "rawSql": "SELECT coalesce(nullif(trim(i.introduction_method), ''), '(not given)') AS introduction_method, count(*) AS count\nFROM participant_participation pp\nJOIN participant_participationplan pl ON pl.id = pp.plan_id\nJOIN participant_participant p ON p.id = pp.participant_id\nJOIN participant_participantinfo i ON i.id = coalesce(pp.info_id, p.info_id)\nWHERE pl.event_id = ${event}\nGROUP BY 1\nORDER BY 2 DESC\nLIMIT 12"
