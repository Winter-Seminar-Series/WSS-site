    {
      "id": 9,
      "type": "timeseries",
      "title": "Registrations per day",
      "description": "",
      "gridPos": {
        "x": 0,
        "y": 6,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "wss-backend-db"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "wss-backend-db"
          },
          "editorMode": "code",
          "format": "time_series",
          "rawQuery": true,
          "rawSql": "SELECT date_trunc('day', pp.date AT TIME ZONE 'Asia/Tehran') AT TIME ZONE 'Asia/Tehran' AS time, count(*) AS registrations\nFROM participant_participation pp\nJOIN participant_participationplan pl ON pl.id = pp.plan_id\nWHERE pl.event_id = ${event}\nAND $__timeFilter(pp.date)\nGROUP BY 1\nORDER BY 1"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": {
            "drawStyle": "bars",
            "fillOpacity": 80,
            "lineWidth": 1,
            "stacking": {
              "mode": "normal",
              "group": "A"
            }
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      }
    },
    {
      "id": 10,
      "type": "timeseries",
      "title": "Orders per day by status",
      "description": "",
      "gridPos": {
        "x": 12,
        "y": 6,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "wss-backend-db"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "wss-backend-db"
          },
          "editorMode": "code",
          "format": "time_series",
          "rawQuery": true,
          "rawSql": "SELECT date_trunc('day', pr.timestamp AT TIME ZONE 'Asia/Tehran') AT TIME ZONE 'Asia/Tehran' AS time, pr.status AS metric, count(*) AS orders\nFROM payment_paymentrequest pr\nWHERE EXISTS (\n  SELECT 1 FROM payment_paymentrequest_plans prp\n  JOIN participant_participationplan pl ON pl.id = prp.participationplan_id\n  WHERE prp.paymentrequest_id = pr.id AND pl.event_id = ${event}\n)\nAND $__timeFilter(pr.timestamp)\nGROUP BY 1, 2\nORDER BY 1"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": {
            "drawStyle": "bars",
            "fillOpacity": 80,
