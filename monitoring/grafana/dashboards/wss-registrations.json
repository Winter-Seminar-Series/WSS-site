    {
      "id": 7,
      "type": "stat",
      "title": "Revenue in range (Toman)",
      "description": "Verified gateway payments inside the selected time range, all editions (the payment database does not know editions). Amounts are stored in Rial.",
      "gridPos": {
        "x": 20,
        "y": 1,
        "w": 4,
        "h": 4
      },
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "wss-payment-db"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "wss-payment-db"
          },
          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT coalesce(sum(to_pay_amount), 0) / 10 AS revenue\nFROM payments\nWHERE payment_status = 3 -- success\nAND $__timeFilter(verified_at)"
        }
