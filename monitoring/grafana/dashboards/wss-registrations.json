    {
      "id": 16,
      "type": "barchart",
      "title": "Top universities",
      "description": "",
      "gridPos": {
        "x": 0,
        "y": 33,
        "w": 12,
        "h": 10
      },
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "wss-backend-db"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "wss-backend-db"
          },
          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT coalesce(nullif(trim(i.university), ''), '(not given)') AS university, count(*) AS count\nFROM participant_participation pp\nJOIN participant_participationplan pl ON pl.id = pp.plan_id\nJOIN participant_participant p ON p.id = pp.participant_id\nJOIN participant_participantinfo i ON i.id = coalesce(pp.info_id, p.info_id)\nWHERE pl.event_id = ${event}\nGROUP BY 1\nORDER BY 2 DESC\nLIMIT 15"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "palette-classic"
          }
        },
        "overrides": []
      },
      "options": {
        "orientation": "horizontal",
        "showValue": "auto",
        "legend": {
          "showLegend": false
        },
        "xTickLabelMaxLength": 40,
        "colorByField": "count"
      }
    },
    {
