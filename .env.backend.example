# Django
SECRET_KEY=change-me
# Never true in production: it exposes tracebacks and the browsable API.
DJANGO_DEBUG=false
# Comma-separated. Defaults: api.wss-sharif.com,api.wss-sharif.ir,backend,localhost,127.0.0.1 (`backend` is how the
# frontend and nginx reach the API inside Docker). A request with any other Host header is refused with a 400.
# ALLOWED_HOSTS=
# CORS_ALLOWED_ORIGINS=https://wss-sharif.com,https://wss-sharif.ir
# CSRF_TRUSTED_ORIGINS=https://api.wss-sharif.com,https://wss-sharif.com,https://api.wss-sharif.ir,https://wss-sharif.ir
# The public site, used in password-reset links and after a free checkout.
FRONTEND_ORIGIN=https://wss-sharif.com
# Proxies in front of the API that append to X-Forwarded-For (nginx, or the frontend relaying nginx's header).
NUM_PROXIES=1
# Rate-limit counters. compose.yaml and compose.dev.yaml run a `redis` service.
REDIS_URL=redis://redis:6379/0

# Postgres — DB_HOST is the compose service name (`postgres`) inside Docker, `localhost` when running Django natively.
DB_HOST=postgres
DB_PORT=5432
DB_NAME=backend
DB_USER=postgres
DB_PASS=change-me

# ArvanCloud S3 (media). Public media (common/storage.py PUBLIC_PREFIXES) gets unsigned URLs; private files get
# signed ones, so they need real keys.
AWS_ACCESS_KEY=change-me
AWS_SECRET_KEY=change-me
AWS_STORAGE_BUCKET_NAME=wss

# Payment microservice (./payment) and the frontend route it redirects back to.
PAYMENT_SERVICE_URL=http://payment:8080
PAYMENT_CALLBACK_URL=https://wss-sharif.com/callback
# Most "complete your registration" reminders a participant gets per edition (Payment requests admin action).
PAYMENT_REMINDER_MAX=2
# Least hours between two reminders to the same person; a second one sooner is skipped (0: no wait).
PAYMENT_REMINDER_INTERVAL_HOURS=48

# Integrations — optional locally. Calls to them give up after INTEGRATION_TIMEOUT seconds.
INTEGRATION_TIMEOUT=15
SKYROOM_API_KEY=
SPOTPLAYER_API_KEY=
EMAIL_HOST=
EMAIL_PORT=465
EMAIL_USER=
EMAIL_PASS=
EMAIL_FROM_ADDRESS=info@wss-sharif.com
EMAIL_FROM_NAME=WSS
# Lifetime of a password-reset link, in seconds.
PASSWORD_RESET_TIMEOUT=3600
