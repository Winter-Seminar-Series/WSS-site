# Frontend runtime env (read by front-compose.yaml). Build-time values (NEXT_PUBLIC_ORIGIN, GA_TRACKING_ID) are
# image build args, see front-compose.yaml; the variables below are only read when the container runs.

# Django API, server-side only (never sent to the browser). Inside Docker it is the backend service on the app network.
API_ORIGIN=http://backend:8000

# iron-session cookie encryption key, at least 32 characters. Changing it signs every user out.
SECRET_COOKIE_PASSWORD=change-me-to-a-random-string-of-32-chars
