# Public origin of this site — used for canonical URLs, sitemap, Open Graph and certificate links.
NEXT_PUBLIC_ORIGIN=https://wss-sharif.com

# Django API. Server-side only (never sent to the browser).
API_ORIGIN=http://localhost:8000

# The current edition's `core_event.id` in the backend (10 → 10th WSS).
WSS_ORDER=10

# iron-session cookie encryption key — at least 32 characters.
SECRET_COOKIE_PASSWORD=change-me-to-a-random-string-of-32-chars

# Google Analytics 4 measurement id — leave empty to disable.
GA_TRACKING_ID=
