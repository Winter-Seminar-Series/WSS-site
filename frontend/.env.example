# Public origin of this site — used for canonical URLs, sitemap, Open Graph and certificate links.
NEXT_PUBLIC_ORIGIN=https://wss-sharif.com

# Django API origin, without `/api` (services/http.ts appends it). Server-side only (never sent to the browser).
# Local backend from ../compose.dev.yaml, or https://api.wss-sharif.com to develop against the production API
# (read-only public data works as is; signing in uses real accounts).
API_ORIGIN=http://localhost:8000

# iron-session cookie encryption key — at least 32 characters.
SECRET_COOKIE_PASSWORD=change-me-to-a-random-string-of-32-chars

# Google Analytics 4 measurement id — leave empty to disable.
GA_TRACKING_ID=
