# Grafana (monitoring-compose.yaml). Generate each secret with `openssl rand -hex 24`.
# The admin account is created on the first start only; later changes to these two have no effect. Change the
# password in the UI (or `docker exec wss-grafana grafana cli admin reset-admin-password …`).
GF_SECURITY_ADMIN_USER=admin
GF_SECURITY_ADMIN_PASSWORD=change-me
# Encrypts the datasource passwords stored in Grafana's database. Never change it once set.
GF_SECURITY_SECRET_KEY=change-me
# Password of the read-only `grafana_reader` Postgres role (monitoring/postgres/roles.sql), used by the
# "WSS backend DB" and "WSS payment DB" datasources.
WSS_DB_READER_PASSWORD=change-me
